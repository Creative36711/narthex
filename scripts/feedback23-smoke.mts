/**
 * Смоук раунда фидбека 23. Запуск: npx tsx scripts/feedback23-smoke.mts
 *
 * Баг: ПЕРВАЯ фраза каждого нового диалога молча умирала, диалог зависал и
 * ждал клика. Причина — дев-режим (StrictMode): эффекты монтирования гоняются
 * «настройка → уборка → настройка». Отдельный «уборочный» эффект
 * (размонтирование) глушил только что заведённую фразу между двумя настройками,
 * а повторная настройка не заводила её заново из-за одноразового
 * предохранителя (spokenRef). Катсцены не болели, т.к. у них эффект заводит
 * озвучку заново без предохранителя.
 *
 * Фикс: эффект озвучки стал идемпотентным — собственная уборка глушит звук,
 * повторная настройка безусловно заводит фразу снова; предохранитель и
 * отдельный уборочный эффект удалены.
 */
import { readFileSync } from 'node:fs'

let failed = 0
function check(name: string, ok: boolean, extra = '') {
  console.log(`${ok ? '✓' : '✗ FAIL'} ${name}${extra ? ` — ${extra}` : ''}`)
  if (!ok) failed++
}
const f = (p: string) => readFileSync(p, 'utf8')
const dlg = f('src/player/DialogueOverlay.tsx')

// идемпотентный эффект: уборка глушит звук, повторная настройка заводит снова
check('эффект озвучки имеет собственную уборку', /playLine\(current\)\s*\r?\n\s*return \(\) => clearLineAudio\(\)/.test(dlg))
check('уборка вызывается при смене строки и при размонтировании', /}, \[d, revealed\]\)/.test(dlg))
// одноразовый предохранитель удалён — повторная настройка обязана заводить фразу
check('одноразовый предохранитель (spokenRef) удалён', !dlg.includes('spokenRef'))
// отдельного «уборочного» эффекта монтирования больше нет (он и ломал дев-режим)
check('отдельный уборочный эффект удалён', !/useEffect\(\(\) => \(\) => clearLineAudio\(\), \[\]\)/.test(dlg))
// темп по-прежнему ведёт голос (фидбек 21), сброс — в фазе рендера (фидбек 22)
check('темп диалога ведёт озвучка', /typed < full\.length \|\| !lineDone/.test(dlg))
check('сброс диалога — синхронно в рендере', dlg.includes('lastDRef.current !== d'))
// страховка от немого синтезатора осталась
check('страховочный таймер против немого синтеза', dlg.includes('fallbackReadMs'))

console.log(failed ? `\nПРОВАЛЕНО: ${failed}` : '\nВСЕ ПРОВЕРКИ ПРОЙДЕНЫ')
process.exit(failed ? 1 : 0)
