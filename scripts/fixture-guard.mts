/**
 * Общий страж фикстур: проверка, которой нужна внешняя кампания, не должна
 * притворяться, что прошла.
 *
 * Часть смоуков проверялась на одноразовой кампании сценариста, которая
 * лежала в `_ai-temp/campaing` и в репозиторий больше не входит. Такой смоук
 * без фикстуры физически не может ничего проверить, поэтому он печатает
 * ПРОПУСК крупными буквами и выходит с кодом 0 — но не молчит.
 *
 * Правило: если проверка нужна постоянно, она должна опираться на фикстуру в
 * репозитории, а не на чужую папку.
 */
import { existsSync } from 'node:fs'

export function skipIfMissingFixture(path: string, what: string): void {
  if (existsSync(path)) return
  console.log('')
  console.log(`ПРОПУСК: нет фикстуры ${path}`)
  console.log(`  не проверено: ${what}`)
  console.log('  почему: одноразовая кампания удалена из репозитория (_ai-temp).')
  console.log('  как вернуть: положить кампанию по этому пути или переписать смоук на фикстуру в tests/fixtures.')
  console.log('')
  process.exit(0)
}
