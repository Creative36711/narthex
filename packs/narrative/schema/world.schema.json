{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narrative world",
  "type": "object",
  "required": ["regions"],
  "properties": {
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "locations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "scenes"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "scenes": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "arrival_scene": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
