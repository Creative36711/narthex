            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Вы закрываете линию клинка, но упускаете шанс на решающий удар.",
                    "action": true
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "stone_r3_mid"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "stone_r3_done"
                  }
                }
              ]
            }
          ],
          "goto": "finale"
        },
        {
          "text": "Карта «Выпад» — ответить на первый жест (1 энергия).",
          "once": true,
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Смотритель уводит клинок в сторону. Последнее очко остаётся за ним.",
                    "action": true
                  }
                },
                {
                  "kind": "effect",
