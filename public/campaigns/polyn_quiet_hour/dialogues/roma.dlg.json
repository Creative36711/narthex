{
  "version": 2,
  "label": "Рома Гладков",
  "nodes": [
    {
      "id": "main",
      "label": "Актовый зал",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Он сидит на третьем ряду спиной к залу и не оборачивается. Ты слышишь только, как он перестал дышать, когда ты вошёл.",
                "action": true
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Тихо. Я свой.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Ты в сапогах. В сапогах не бывают свои.",
                    "emotion": "afraid"
                  }
                }
              ]
            }
          ],
          "goto": "node_trust",
          "check": {
            "skill": "listen",
            "difficulty": "normal",
            "success": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Он услышал, как ты снял куртку прежде, чем заговорить, и это его устроило.",
                        "emotion": "calm"
                      }
                    }
                  ]
                }
              ],
              "goto": "node_trust"
            },
            "fail": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Ты сказал это слишком громко: в зале загудел пол.",
                        "emotion": "afraid"
                      }
                    }
                  ]
                }
              ],
              "goto": "node_shoo"
            }
          }
        },
        {
          "text": "Эй! Тут кто-то есть?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "В зале стало пусто тем особым способом, когда пусто не стало.",
                    "action": true
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Уйти, не шуметь.",
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "node_trust",
      "label": "Вопрос",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Я не могу уйти, пока не дождусь. Меня в журнале записали «выбывшим». Выбывшие не уходят, их выносят.",
                "emotion": "afraid"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Он говорит вполголоса, потому что его учили: в коридорах слышно, как ты дышишь.",
                "action": true
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "За что тебя в шкаф?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "flag_roma_told"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "За разговор. Я спросил, где Ветрова. Она не имела права отвечать, а я — спрашивать.",
                    "emotion": "crying"
                  }
                }
              ]
            }
          ],
          "goto": "node_key"
        },
        {
          "text": "Как выглядит Инна Аркадьевна?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Она красивая и спокойная. Это самое опасное: она нас успокаивала.",
                    "emotion": "afraid"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Ты держал вот это? — показать значок",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Он смотрит на твою руку и не тянется. Он ждёт, что ты пошутишь.",
                    "emotion": "crying"
                  }
                }
              ]
            }
          ],
          "goto": "node_give",
          "conds": [
            {
              "type": "has_item",
              "item": "item_znachok"
            }
          ]
        }
      ]
    },
    {
      "id": "node_give",
      "label": "Значок",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Это не шутка? — он берёт значок двумя пальцами, как берут что-то из чужого кармана.",
                "emotion": "afraid"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Он твой. Он под скамейкой лежал.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_bridge_roma_done"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_bridge_znachok"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Второй ключ — под портретом, — говорит он, не поднимая головы. — Она посадит тебя к себе в кабинет и будет ждать, что ты сам ляжешь. Не ложись сам.",
                    "emotion": "calm"
                  }
                }
              ]
            }
          ],
          "goto": "node_key"
        },
        {
          "text": "Отдай — и я вспомню, где ты лежал.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Он спрятал значок в карман и отвернулся. В зале стало на одного меньше.",
                    "emotion": "hollow"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        }
      ]
    },
    {
      "id": "node_key",
      "label": "Ключ и предупреждение",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "В методкабинете шкаф с номером. У директора есть ключ, у Инны Аркадьевны есть второй. Второй — в левом рукаве: она кладёт его туда, когда ждёт.",
                "emotion": "neutral"
              }
            }
          ]
        },
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Он назвал имя «Лёля». Зал не ответил — это было хуже ответа.",
                "action": true
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Спасибо, Рома.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Ты принесёшь меня сюда? — спрашивает он, и ты понимаешь, что он спрашивает не про себя.",
                    "emotion": "afraid"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Идти в методкабинет сейчас?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Сейчас нельзя. Сейчас тихий час; сейчас все смотрят, кто ходит.",
                    "emotion": "afraid"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        }
      ]
    },
    {
      "id": "node_shoo",
      "label": "Пропажа",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Стулья в первых трёх рядах легли на бок сами. Мальчика в зале нет, и в твоём кармане стало теплее на один предмет, которого там не было.",
                "action": true
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "flag_roma_shows"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Остаться и ждать.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Ты ждал до шестого утра. Он не пришёл. Пришли стулья: ровно, один за другим, встали на место.",
                    "emotion": "neutral"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Уйти.",
          "sections": [],
          "goto": "end"
        }
      ]
    }
  ]
}