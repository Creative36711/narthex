{
  "version": 2,
  "label": "Геннадич, предшествующий охранник",
  "nodes": [
    {
      "id": "main",
      "label": "Подпись и три правила",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Он держит кружку двумя руками. Кружку двумя руками держат, когда мёрзнешь не от ветра.",
                "action": true
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "{имя}. Подпиши — и гуляй три ночи. Я здесь для того, чтобы ты подписал, а не чтобы ты спрашивал.",
                "emotion": "neutral"
              }
            }
          ],
          "goto": ""
        },
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Полшестого утра. Не раньше. Я не останусь до утра, и тебе не советую.",
                "emotion": "tense"
              }
            }
          ],
          "conds": [
            {
              "type": "flag",
              "flag": "flag_shift_started"
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Какие тут правила?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Правила не для мародёров. Правила, чтобы тебя посчитали своим.",
                    "emotion": "neutral"
                  }
                }
              ]
            }
          ],
          "goto": "node_rules"
        },
        {
          "text": "Что здесь случилось в восемьдесят шестом?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Никто ничего не слышал. Это и есть беда: двадцать восемь детей в двухстах метрах — и ни одного свидетеля.",
                    "emotion": "tense"
                  }
                }
              ]
            }
          ],
          "goto": "node_1986"
        },
        {
          "text": "Дай чего-нибудь: кофе, спички, керосин.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Бери. Записывай в журнал — я на тебя не взыскиваю.",
                    "emotion": "calm"
                  }
                }
              ]
            }
          ],
          "goto": "node_trade"
        },
        {
          "text": "Я, пожалуй, поеду.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Правильно.",
                    "emotion": "calm"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Он сказал это слишком быстро, чтобы это было сочувствием.",
                    "action": true
                  }
                }
              ]
            }
          ],
          "goto": "node_leave"
        },
        {
          "text": "Отдыхай. Я обойду сам.",
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "node_rules",
      "label": "Первое и второе",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Первое: после отбоя по корпусу ходят. Не бегают. Каблук и подошва звучат по-разному, и на третьем этаже это слышно как в ухе.",
                "emotion": "neutral"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Второе?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Второе: свет. В щитке на этаже должен сидеть предохранитель. Без лампы он не выходит, но и ты без лампы не выйдешь.",
                    "emotion": "tense"
                  }
                }
              ]
            }
          ],
          "goto": "node_rules2"
        },
        {
          "text": "Понял. Дальше.",
          "sections": [],
          "goto": "node_rules2"
        }
      ]
    },
    {
      "id": "node_rules2",
      "label": "Три стука",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Третье. В дверь стучат три раза — не открывай, не отвечай, не дыши в замочную скважину. Это не гость. Это проверка на голос.",
                "emotion": "tense"
              }
            }
          ]
        },
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Один раз в восемьдесят девятом я сказал «занято». Наутро в журнале обходов стояла моя фамилия — не в графе «осмотрел», а в графе «выбыла». Три недели я лежал в районной и не помню, как дошёл до бытовки.",
                "emotion": "afraid"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Он отпил из кружки и поморщился не от горячего.",
                "action": true
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Как мне это понимать?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "flag_rules_known"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "flag_knocks_rule_known"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_knocks"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_regime"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Как инструктаж. Лагерь принимает только тех, кто соблюдает режим. Нарушишь — станешь частью журнала.",
                    "emotion": "neutral"
                  }
                }
              ]
            }
          ],
          "goto": "node_payoff"
        },
        {
          "text": "Ты шутишь.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Я одиннадцать лет не шучу. Мне за это платят.",
                    "emotion": "angry"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        }
      ]
    },
    {
      "id": "node_1986",
      "label": "Смена «Солнышко»",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Я в восемьдесят шестом был дежурным взрослым. Не воспитателем — именно дежурным: обход, журнал, «тихо». Методичку писал не я.",
                "emotion": "neutral"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "«Методичку» он произнёс так, как произносят «могилу».",
                "action": true
              }
            }
          ]
        },
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Старшая вожатая, Ветрова Инна Аркадьевна, считала, что тихий час надо доводить до конца. У неё был шкаф в методкабинете и была вера в доведение до конца.",
                "emotion": "tense"
              }
            }
          ],
          "conds": [
            {
              "type": "flag",
              "flag": "flag_rules_known"
            }
          ],
          "else_steps": [
            {
              "kind": "line",
              "line": {
                "text": "Я тебе этого не говорил. Иди, осмотри корпус.",
                "emotion": "neutral"
              }
            }
          ],
          "else_goto": "end"
        }
      ],
      "choices": [
        {
          "text": "Где сейчас Инна Аркадьевна?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "В методкабинете. Где ж ещё. Она тридцать лет не уходит со смены: формально её там нет, но ты ж не формальный.",
                    "emotion": "afraid"
                  }
                }
              ]
            }
          ],
          "goto": "node_flask"
        },
        {
          "text": "Кто ещё из взрослых остался?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Из живых — я, Зоя Романовна да Губарь. Директор приедет за архивом, который сам же сорок лет и прячет.",
                    "emotion": "neutral"
                  }
                }
              ]
            }
          ],
          "goto": "node_payoff"
        },
        {
          "text": "Дальше.",
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "node_flask",
      "label": "Фляга",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Слушай, {имя}. В двенадцатом шкафчике у меня фляга. Не пить — память. Отдай до утра, и я дам тебе то, чего не давал никому: ключ от подвала и подпись в журнале за тебя.",
                "emotion": "tense"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Заберу. Она в спальном?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "flag_gennadich_asked"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "start_quest",
                    "quest": "quest_gennadich_flask"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_description",
                    "entity": "npc_gennadich",
                    "text": "Геннадич следит, чтобы ты не задержался у двери спального корпуса дольше, чем нужно."
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Двенадцатый шкафчик, верхняя полка. Не перепутай с тринадцатым: тринадцатого нет.",
                    "emotion": "neutral"
                  }
                }
              ]
            }
          ],
          "goto": "end",
          "once": true
        },
        {
          "text": "Вот твоя фляга.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_bridge_flask"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Он выкрутил крышку, понюхал и не стал пить — просто подержал у носа, как держат чужое письмо.",
                    "action": true
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Спасибо. Ключ — на. И вот: чай, спички. Не благодари, иди обходить.",
                    "emotion": "calm"
                  }
                }
              ]
            }
          ],
          "goto": "node_payoff",
          "conds": [
            {
              "type": "has_item",
              "item": "item_flask"
            }
          ],
          "once": true
        },
        {
          "text": "Не до фляг сейчас.",
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "node_trade",
      "label": "Лавка у печки",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Что нужно? Кофе, керосин, «Планета» в батарейках, валериана по шесть капель. У тебя {счёт:item_ruble} рублей.",
                "emotion": "neutral"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Много для лагеря, где не на что тратить, и мало для лагеря, где можно купить тишину.",
                "action": true
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Покажи товар.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "open_trade",
                    "npc": "npc_gennadich"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Ничего.",
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "node_payoff",
      "label": "Расчёт и совет",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Расчёт в конце смены. Восемь объектов внесёшь в опись — Зоя доплатит и не будет вычитать. Пять — вычтет.",
                "emotion": "neutral"
              }
            }
          ]
        },
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "И ещё: у воды её не зови по имени. Она и так слышит, а имя — это приглашение подойти.",
                "emotion": "tense"
              }
            }
          ],
          "conds": [
            {
              "type": "flag",
              "flag": "flag_lelya_shows"
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Как бы отсюда уехать, если что?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Калитка на весу, замок мой. Скажи слово — открою и отвезу до трассы. Только не говори потом, что я не предупреждал.",
                    "emotion": "calm"
                  }
                }
              ]
            }
          ],
          "goto": "node_leave"
        },
        {
          "text": "Спасибо. Иди спать.",
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "node_leave",
      "label": "Уехать",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Открою. Честно: за одиннадцать лет отсюда уехал один я. И то ночью, и то не сразу.",
                "emotion": "calm"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Открой калитку. Я уезжаю.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_bridge_flee"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Замок щёлкнул, и лагерь за спиной перестал быть твоим.",
                    "action": true
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Подожду до утра.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Вот и я когда-то подождал.",
                    "emotion": "tense"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        }
      ]
    }
  ]
}