       "flag": "secret_path_used"
      }
     ],
     "else_steps": [
      {
       "kind": "effect",
       "effect": {
        "type": "fire_rule",
        "rule": "encounter_camp_fight"
       }
      }
     ]
    }
   ],
   "choices": [],
   "goto": "end"
  }
 ]
}