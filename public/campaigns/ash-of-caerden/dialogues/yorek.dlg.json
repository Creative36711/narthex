{
 "version": 2,
 "label": "Йорек, вожак банды",
 "nodes": [
  {
   "id": "main",
   "label": "Начало разговора",
   "sections": [
    {
     "steps": [
      {
       "kind": "line",
       "line": {
        "text": "Ты испытываешь моё терпение, наёмник.",
        "emotion": "angry"
       }
      }
     ],
     "conds": [
      {
       "type": "flag",
       "flag": "yorek_met"
      }
     ],
     "else_steps": [
      {
       "kind": "effect",
       "effect": {
        "type": "set_flag",
        "flag": "yorek_met"
       }
      },
      {
       "kind": "line",
       "line": {
        "text": "Смелый гость. Или глупый."
       }
      },
      {
       "kind": "line",
       "line": {
        "text": "Седой воин с клейморой за спиной неспешно поднимается от костра. Вокруг из палаток выходят люди — с ножами и дубинами.",
        "action": true
       }
      },
      {
       "kind": "line",
       "line": {
        "text": "Я Йорек. Эта долина кормит моих людей. Говори, зачем пришёл, — и, может быть, уйдёшь на своих ногах."
       }
      }
     ]
    }
   ],
   "choices": [
    {
     "text": "«Уходите из долины — или ляжете в неё». (Убеждение)",
     "once": true,
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Йорек мрачно оглядывается: вы пришли из его собственного тыла, и он это понимает. Лагерь не так неприступен, как он думал.",
          "action": true
         }
        }
       ],
       "conds": [
        {
         "type": "flag",
         "flag": "secret_path_used"
        }
       ]
      }
     ],
     "check": {
      "skill": "persuade",
      "difficulty": 60,
      "mods": [
       {
        "conds": [
         {
          "type": "flag",
          "flag": "secret_path_used"
         }
        ],
        "value": 40
       }
      ],
      "fail": {
       "sections": [
        {
         "steps": [
          {
           "kind": "line",
           "line": {
            "text": "Йорек долго смотрит на вас… и сплёвывает.",
            "emotion": "angry",
            "action": true
           }
          },
          {
           "kind": "line",
           "line": {
            "text": "Языкатых я вешаю на осинах вдоль тракта."
           }
          }
         ]
        }
       ],
       "goto": "fight_starts"
      },
      "success": {
       "sections": [
        {
         "steps": [
          {
           "kind": "line",
           "line": {
            "text": "Йорек щурится. Долгая пауза.",
            "action": true
           }
          }
         ]
        },
        {
         "steps": [
          {
           "kind": "line",
           "line": {
            "text": "Стража уже в моём лагере… Значит, город всерьёз взялся за нас."
           }
          }
         ],
         "conds": [
          {
           "type": "in_party",
           "npc": "npc_guard_aldric"
          }
         ]
        },
        {
         "steps": [
          {
           "kind": "line",
           "line": {
            "text": "Хм. Караваны обмельчали, стража зашевелилась… а теперь ещё и ты. Пожалуй, эта долина и впрямь выжата досуха."
           }
          },
          {
           "kind": "line",
           "line": {
            "text": "Мы уходим за холмы. Но запомни, наёмник: дороги длинные, а память у меня долгая."
           }
          },
          {
           "kind": "effect",
           "effect": {
            "type": "set_flag",
            "flag": "bandit_deal_made"
           }
          }
         ]
        }
       ],
       "goto": "end"
      }
     },
     "goto": "stay"
    },
    {
     "text": "«Сто марок серебром — и вы уходите». (100 SM)",
     "conds": [
      {
       "type": "item_ge",
       "item": "item_silver",
       "count": 100
      }
     ],
     "sections": [
      {
       "steps": [
        {
         "kind": "effect",
         "effect": {
          "type": "remove_item",
          "item": "item_silver",
          "qty": 100
         }
        },
        {
         "kind": "line",
         "line": {
          "text": "Йорек взвешивает кошель на ладони.",
          "action": true
         }
        },
        {
         "kind": "line",
         "line": {
          "text": "Серебро не пахнет кровью — уже хорошо. По рукам. К рассвету нас здесь не будет."
         }
        },
        {
         "kind": "effect",
         "effect": {
          "type": "set_flag",
          "flag": "bandit_deal_made"
         }
        }
       ]
      }
     ],
     "goto": "end"
    },
    {
     "text": "«К оружию!» (бой)",
     "sections": [],
     "goto": "fight_starts"
    },
    {
     "text": "«Я ещё вернусь». (уйти)",
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Возвращайся с серебром. Или не возвращайся вовсе."
         }
        }
       ]
      }
     ],
     "goto": "end"
    }
   ]
  },
  {
   "id": "fight_starts",
