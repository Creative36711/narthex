{
 "version": 2,
 "label": "Бран, торговец с рынка",
 "nodes": [
  {
   "id": "main",
   "label": "Начало разговора",
   "sections": [
    {
     "steps": [
      {
       "kind": "line",
       "line": {
        "text": "Снова ты. Подходи, товар нынче — что уцелело."
       }
      }
     ],
     "conds": [
      {
       "type": "flag",
       "flag": "met_bran"
      }
     ],
     "else_steps": [
      {
       "kind": "effect",
       "effect": {
        "type": "set_flag",
        "flag": "met_bran"
       }
      },
      {
       "kind": "line",
       "line": {
        "text": "Подходи, не стесняйся! Бран, лучшие товары долины...",
        "emotion": "happy"
       }
      },
      {
       "kind": "line",
       "line": {
        "text": "...точнее, то, что от них осталось. Два моих каравана взяла банда с холмов. Ещё месяц такой торговли — и я пойду по миру."
       }
      }
     ]
    },
    {
     "steps": [
      {
       "kind": "line",
       "line": {
        "text": "У тебя {item_count(\"item_silver\")} марок серебром."
       }
      }
     ]
    }
   ],
   "choices": [
    {
     "text": "Показывай товар. (торговля)",
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Выбирай, всё лучшее — на прилавке.",
          "emotion": "happy"
         }
        },
        {
         "kind": "effect",
         "effect": {
          "type": "open_trade",
          "npc": "npc_bran"
         }
        }
       ]
      }
     ],
     "goto": "end"
    },
    {
     "text": "Цены у тебя грабительские. (Торговля)",
     "once": true,
     "conds": [
      {
       "type": "flag",
       "flag": "bran_bargained",
       "not": true
      }
     ],
     "sections": [
      {
       "steps": [
        {
         "kind": "effect",
         "effect": {
          "type": "set_flag",
          "flag": "bran_bargained"
         }
        }
       ]
      }
     ],
     "check": {
      "skill": "bargain",
      "difficulty": 50,
      "fail": {
       "sections": [
        {
         "steps": [
          {
           "kind": "line",
           "line": {
            "text": "Грабительские?! Да я себе в убыток торгую!"
           }
          },
          {
           "kind": "line",
           "line": {
            "text": "Иди поищи дешевле — до Вельдена четыре дня пути."
           }
          }
         ]
        }
       ],
       "goto": "stay"
      },
      "success": {
       "sections": [
        {
         "steps": [
          {
           "kind": "line",
           "line": {
            "text": "Тьфу, язык у тебя подвешен... Ладно. Держи хлеб сверху, только отстань.",
            "emotion": "happy"
           }
          },
          {
           "kind": "effect",
           "effect": {
            "type": "add_item",
            "item": "item_bread",
            "qty": 1
           }
          }
         ]
        }
       ],
       "goto": "stay"
      }
     },
     "goto": "stay"
    },
    {
     "text": "Что за банда вас грабит?",
     "once": true,
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Организованные, со своим главарём — Серым Йореком.",
          "emotion": "angry"
         }
        },
        {
         "kind": "line",
         "line": {
          "text": "Прячутся в Волчьей балке — это за лесом, к северо-западу. Я отмечу тебе место."
         }
        },
        {
         "kind": "effect",
         "effect": {
          "type": "set_flag",
          "flag": "bran_told_about_bandits"
         }
        },
        {
         "kind": "line",
         "line": {
          "text": "Сотня марок тому, кто избавит долину от этой заразы — моё слово твёрдое. Но в одиночку туда идти — верная смерть. Поговори с Алдриком: стража тоже точит зуб на Йорека."
         }
        }
       ]
      }
     ],
     "goto": "stay"
    },
    {
     "text": "Удачи в торговле.",
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "И тебе дорог без разбойников."
         }
        }
       ]
      }
     ],
     "goto": "end"
    }
   ]
  }
 ]
}