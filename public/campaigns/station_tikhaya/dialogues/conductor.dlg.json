{
  "version": 2,
  "label": "Проводник последнего поезда",
  "nodes": [
    {
      "id": "main",
      "label": "Поезд",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Билеты. Последний на юг сегодня. Дальше — только утренний, через десять часов тишины.",
                "emotion": "neutral"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Уезжаю. Один.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "boarded_alone"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ending_leave"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Вагон пахнет железом и чьим-то одеколоном. Окно отражает станцию — всё меньше.",
                    "emotion": "soft"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Мы вдвоём. (Лена рядом)",
          "conds": [
            {
              "type": "flag",
              "flag": "lena_will_go"
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "boarded_with_lena"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ending_together"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Она держит сумку двумя руками. Пальцы белые. Но смотрит не назад — вперёд.",
                    "emotion": "warm"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Я передумал. Остаюсь.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "refused_train"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ending_stay"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Проводник кивает, будто слышал это сто раз. Поезд всё равно уйдёт. Ты — нет.",
                    "emotion": "soft"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Ещё не сейчас. Сколько минут?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Сколько успеешь наговорить правды. Гудок — и разговор кончится без тебя.",
                    "emotion": "neutral"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        }
      ]
    }
  ]
}
