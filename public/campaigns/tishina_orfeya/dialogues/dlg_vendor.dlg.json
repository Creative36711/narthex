{
  "version": 2,
  "label": "Припой — торговый дроид",
  "nodes": [
    {
      "id": "n_start",
      "label": "Припой",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "ПРИПОЙ: «Добрый день! Торговый дроид „Припой“. Платите кредитами, не спрашивайте, откуда они у меня.»",
                "emotion": "happy"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Показать товары",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "ПРИПОЙ: «Разложил. Всё честное, кроме этикеток.»",
                    "emotion": "happy"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "open_trade",
                    "npc": "npc_vendor"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Откуда у вас кредиты?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "ПРИПОЙ: «Кредиты — это записи. Записи остаются после людей. Я просто перераспределяю остатки.»",
                    "emotion": "calm"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Что на корабле?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "ПРИПОЙ: «Сигнал? Это не товар. Зато есть изоляционная лента: от сигналов не спасает, зато склеит что угодно.»"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "До связи",
          "sections": [],
          "goto": "end"
        }
      ],
      "goto": "end"
    }
  ]
}