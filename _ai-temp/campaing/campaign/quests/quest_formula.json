{
  "id": "quest_formula",
  "label": "Формула Калеба",
  "description": "Калеб верит, что Ядро можно переключить на рудные стержни — но схему нужно добыть в Архиве Гильдии.",
  "chapter": "ch3",
  "journal_entries": {
    "j_plan": "Калеб рассказал, как переключить Ядро на кревнорудные стержни. Схема хранится в Архиве под Башней Гильдии. Мавра уже дала мне пропуск — или я его силой возьму.",
    "j_archives": "Я в Архиве. Чертёж должен быть где-то на полках.",
    "j_truth": "Я прочёл хроники Основателей. Ядро — не просто двигатель. Это живой механизм, питающийся жизненной силой. Каждый месяц восемьдесят лет оно ело по одному рабочему.",
    "j_schematic": "Схема обходного клапана у меня. Пора идти в туннели к Ядру."
  },
  "stages": [
    {
      "id": "stage_plan",
      "label": "Попасть в Архивы",
      "on_enter_effects": [
        { "type": "journal_update", "quest": "quest_formula", "text_key": "j_plan" },
        { "type": "reveal_location", "location": "loc_guild_hall" }
      ],
      "transitions": [
        { "to": "stage_archives", "conditions": [{ "type": "player_enters_scene", "scene": "scene_archives" }] }
      ]
    },
    {
      "id": "stage_archives",
      "label": "Отыскать схему",
      "on_enter_effects": [
        { "type": "journal_update", "quest": "quest_formula", "text_key": "j_archives" },
        { "type": "unlock_codex", "entry": "codex_ageofsteam" }
      ],
      "transitions": [
        { "to": "stage_truth", "conditions": [
          { "type": "has_item", "item": "item_schematic" }
        ]}
      ]
    },
    {
      "id": "stage_truth",
      "label": "Прочитать правду",
      "on_enter_effects": [
        { "type": "journal_update", "quest": "quest_formula", "text_key": "j_truth" },
        { "type": "set_flag", "flag": "learned_truth" },
        { "type": "reveal_location", "location": "loc_tunnels" }
      ],
      "transitions": [
        { "to": "stage_done", "conditions": [
          { "type": "player_enters_location", "location": "loc_tunnels" }
        ]}
      ]
    },
    {
      "id": "stage_done",
      "label": "Пора к Ядру",
      "on_enter_effects": [
        { "type": "journal_update", "quest": "quest_formula", "text_key": "j_schematic" }
      ],
      "final": true,
      "outcome": "success"
    }
  ]
