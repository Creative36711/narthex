{
  "version": 2,
  "label": "Ханна, лекарка",
  "nodes": [
    {
      "id": "main",
      "label": "Стол у шкафа",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Кладите руки на стол. Что болит — само скажет."
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "У вас {здоровье} здоровья из {здоровье_макс}. Плечи как у шахтёра, глаза как у человека, который мало спит."
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Подлечите меня (6 см).",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "remove_item",
                    "item": "item_silver",
                    "qty": 6
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_medic_help"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Готово. Дышите мелко, три часа не спорьте с караулом."
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "item_ge",
              "item": "item_silver",
              "count": 6
            }
          ]
        },
        {
          "text": "Купить осадок от ржави (10 см).",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "remove_item",
                    "item": "item_silver",
                    "qty": 10
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "add_item",
                    "item": "item_tonic",
                    "qty": 1
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Пейте сразу, как пальцы начнут не слушаться. Это не лечение, инспектор. Это отсрочка."
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "item_ge",
              "item": "item_silver",
              "count": 10
            }
          ]
        },
        {
          "text": "Что такое ржавь?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Счёт. Вы думаете, это болезнь, а это счёт, который вам выставили. Металл растёт там, где жило тепло."
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_rust"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Что говорят тела из ям?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Вкладыши у них в черепах. Латунь, шлифованная, с номером. Такие ставят не мертвым, а живым — чтобы держался в машине."
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "И ещё: у всех четырёх волосы чистые. Их мыли перед тем, как подключать."
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_medic_names"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Что у вас от ржави?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Осадок. Трава-жгунец, спирт и время. Держите, я запишу, как делать."
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_medic_recipe"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "clinic_helped"
            },
            {
              "type": "flag",
              "flag": "recipe_tonic_known",
              "not": true
            }
          ]
        },
        {
          "text": "Проверьте, как я дышу.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Лёгкие как у шахтёра: угар есть, но немного. Меняйте уголь в маске каждый день."
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_medic_lungs"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "fume_first"
            }
          ]
        },
        {
          "text": "До встречи.",
          "sections": [],
          "goto": "end"
        }
      ],
      "goto": "end"
    }
  ]
}
