{
  "version": 2,
  "label": "Сестра Айла, лекарь",
  "nodes": [
    {
      "id": "Начало",
      "label": "Начало разговора",
      "sections": [
        {
          "conds": [
            {
              "type": "flag",
              "flag": "met_ayla"
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Айла кивает на табурет, не отрываясь от бинтов.",
                "action": true,
                "voice": "assets/voice/narr_ayla_rep.mp3"
              }
            }
          ],
          "else_steps": [
            {
              "kind": "line",
              "line": {
                "text": "Женщина промокает бинт и не смотрит на твои руки.",
                "action": true,
                "sfx": "sfx_water",
                "voice": "assets/voice/narr_ayla_1.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Я Айла. Сядь. У тебя ссадина на костяшках и вид человека, который не спал двое суток.",
                "voice": "assets/voice/ayla_14.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Двое суток без сна — это полдела. За трое начинают мерещиться вещи, которые потом вносят в протокол.",
                "voice": "assets/voice/ayla_8.mp3"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "learn_name",
                "entity": "npc_ayla",
                "silent": true
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "met_ayla"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Перевяжи меня (10 марок).",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Держи. Не дёргайся: я режу ровно, но больно.",
                    "emotion": "calm",
                    "voice": "assets/voice/ayla_4.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "remove_item",
                    "item": "item_mark",
                    "qty": 10
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_hp",
                    "delta": 14
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "item_ge",
              "item": "item_mark",
              "count": 10
            }
          ]
        },
        {
          "text": "Убери гнилец (30 марок).",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Отвар горький. Гнилец горше. Глотай, не нюхай.",
                    "emotion": "calm",
                    "voice": "assets/voice/ayla_5.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "remove_item",
                    "item": "item_mark",
                    "qty": 30
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "remove_status",
                    "status": "status_rot"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_hp",
                    "delta": 4
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "has_status",
              "status": "status_rot"
            },
            {
              "type": "item_ge",
              "item": "item_mark",
              "count": 30
            }
          ]
        },
        {
          "text": "Научи готовить настой.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Рецепт простой, как всё, что спасает жизнь: трава, вода и терпение.",
                    "emotion": "calm",
                    "voice": "assets/voice/ayla_6.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Если пойдёшь на девятый, возьми мой настой. Он не от воды. Он от того, что в воде.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/ayla_9.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Если услышишь, что жила поёт — не останавливайся слушать. Её песня не звук, она в костях. Заслушаешься — останешься внизу.",
                    "emotion": "afraid",
                    "voice": "assets/voice/ayla_warn.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_recipe",
                    "recipe": "recipe_tonic"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ayla_recipe"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ayla",
                    "delta": 10
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "ayla_recipe",
              "not": true
            }
          ],
          "once": true
        },
        {
          "text": "Ты знала стража Ярова?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Яров? Приходил за бинтами тринадцатого, вечером. Уходил не один — со стражей.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/ayla_2.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Сказал: «затвор закрывать». Я спросила: «а люди?» Он не ответил.",
                    "voice": "assets/voice/ayla_3.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_description",
                    "entity": "npc_ayla",
                    "text": "Лекарь Сухого ряда. Знает, кто уходил закрывать затвор — и кто не вернулся."
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "clue_guard"
            }
          ]
        },
        {
          "text": "Торговать.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Бери, что нужно. И оставь себе на воду — воды всегда нужно больше.",
                    "emotion": "calm",
                    "voice": "assets/voice/ayla_7.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "open_trade",
                    "npc": "npc_ayla"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Показать Айле находку с привода.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "present_item",
                    "ok": "Рукавица",
                    "fail": "Не_то",
                    "required": "item_glove"
                  }
                }
              ]
            }
          ],
          "goto": "end",
          "conds": [
            {
              "type": "flag",
              "flag": "clue_glove"
            },
            {
              "type": "flag",
              "flag": "ayla_glove",
              "not": true
            }
          ]
        },
        {
          "text": "Чем забиваются банки в дыхателе?",
          "conds": [
            {
              "type": "has_item",
              "item": "item_filter"
            }
          ],
          "goto": "stay",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Жильной взвесью. Она не пыль — она в угле живёт и разбухает от сырости. Продуть банку нельзя, можно только сменить на верстаке.",
                    "emotion": "calm",
                    "voice": "assets/voice/ayla_11.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Если банки сдохли внизу — не паникуй. Два угля, тряпка и ровный стол. Не экономь на угле: тонкий слой продувается за две минуты.",
                    "emotion": "calm",
                    "voice": "assets/voice/ayla_filter.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_filter"
                  }
                }
              ]
            }
          ]
        },
        {
          "text": "Под рёбрами гудит. Что со мной?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Зов жилы. Кто-то продал тебе стекло, и ты носишь его у сердца. Носи в сумке, в тряпице, и не слушай.",
                    "emotion": "angry",
                    "voice": "assets/voice/ayla_12.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Выпей. Горько, зато в голове будет тихо.",
                    "emotion": "calm",
                    "voice": "assets/voice/ayla_13.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ayla_veinsong"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "has_status",
              "status": "status_veinsong"
            }
          ]
        },
        {
          "text": "Пока.",
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "Рукавица",
      "label": "Рукавица с привода",
      "sections": [
        {
          "steps": [
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "ayla_glove"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Заплату на рукавице я узнаю: ставила осенью, в рядке. Чья — не помню: ладони у всех в мазуте, а имён я не спрашиваю. А клеймо караульное, это точно.",
                "emotion": "thoughtful",
                "voice": "assets/voice/ayla_10.mp3"
              }
            }
          ]
        }
      ],
      "goto": "Начало",
      "choices": []
    },
    {
      "id": "Не_то",
      "label": "Не та вещь",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Это не по моей части. Я штопаю и лечу, а железо неси Дожу.",
                "voice": "assets/voice/ayla_15.mp3",
                "emotion": "calm"
              }
            }
          ]
        }
      ],
      "goto": "Начало",
      "choices": []
    }
  ]
}