        {
          "text": "Как ты держишься?",
          "conds": [
            {
              "type": "in_party",
              "npc": "npc_resh"
            }
          ],
          "sections": [
            {
              "conds": [
                {
                  "type": "flag",
                  "flag": "resh_worn"
                }
              ],
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Колени не держат, а живот гудит громче жилы. Дай хоть сухарь и глоток воды — и пойду дальше.",
                    "voice": "assets/voice/resh_19.mp3",
                    "emotion": "tired"
                  }
                }
              ],
              "else_steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Сорок лет под землёй. Ещё один день я выдержу — лишь бы не зря.",
                    "voice": "assets/voice/resh_20.mp3",
                    "emotion": "calm"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Возвращайся к забою. Дальше я сам.",
          "conds": [
            {
              "type": "in_party",
              "npc": "npc_resh"
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
