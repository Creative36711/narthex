{
  "version": 2,
  "label": "Ира Ярова, помощница мастера",
  "nodes": [
    {
      "id": "Начало",
      "label": "Начало разговора",
      "sections": [
        {
          "conds": [
            {
              "type": "flag",
              "flag": "met_ira"
            },
            {
              "type": "in_party",
              "npc": "npc_ira"
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Ира идёт рядом, держа фонарь пониже, и ждёт, что ты скажешь.",
                "action": true,
                "voice": "assets/voice/narr_ira_14.mp3"
              }
            }
          ]
        },
        {
          "conds": [
            {
              "type": "flag",
              "flag": "met_ira"
            },
            {
              "type": "in_party",
              "not": true,
              "npc": "npc_ira"
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Ира поднимает глаза от пульта и ждёт, что ты скажешь.",
                "action": true,
                "voice": "assets/voice/narr_ira_rep.mp3"
              }
            }
          ]
        },
        {
          "conds": [
            {
              "type": "flag",
              "flag": "met_ira",
              "not": true
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Ира стирает мазут с ладоней ветошью и смотрит на тебя исподлобья.",
                "action": true,
                "voice": "assets/voice/narr_ira_1.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Ты насчёт помпы? Я Ира Ярова, помощница мастера. Всё уже рассказала старшине — он велел не мешать.",
                "voice": "assets/voice/ira_1.mp3",
                "emotion": "afraid"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "learn_name",
                "entity": "npc_ira",
                "silent": true
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "met_ira"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Расскажи, что случилось в ночь тринадцатого.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ira_story"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Смена шла ровно. В восемнадцать сорок мастер спустился в шахту: сказал — проверить привод.",
                    "voice": "assets/voice/ira_4.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "В девятнадцать десять помпа встала. В двадцать ноль-ноль в зал зашёл Келл со взводом и велел всем выйти.",
                    "voice": "assets/voice/ira_2.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Она вытирает ладони о штаны. Полотно всё равно чёрное.",
                    "action": true,
                    "sfx": "snd_cloth",
                    "voice": "assets/voice/narr_ira_2.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 6
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ira_story"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true,
          "conds": [
            {
              "type": "flag",
              "flag": "ira_story",
              "not": true
            }
          ]
        },
        {
          "text": "Где ключ от каморки мастера?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ira_key_asked"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "check": {
            "skill": "persuade",
            "difficulty": 50,
            "success": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "У меня был второй, на случай смены. Держи — только не говори, что я дала.",
                        "voice": "assets/voice/ira_12.mp3"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "add_item",
                        "item": "item_key_resh",
                        "qty": 1
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "npc_ira",
                        "delta": 6
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            },
            "fail": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Ключ был у мастера. Где мастер — там и ключ.",
                        "voice": "assets/voice/ira_13.mp3"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "npc_ira",
                        "delta": -3
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            }
          },
          "once": true,
          "conds": [
            {
              "type": "has_item",
              "item": "item_key_resh",
              "not": true
            },
            {
              "type": "flag",
              "flag": "resh_room_open",
              "not": true
            },
            {
              "type": "flag",
              "flag": "ira_key_asked",
              "not": true
            },
            {
              "type": "in_party",
              "npc": "npc_ira",
              "not": true
            }
          ]
        },
        {
          "text": "Твой брат — Стась Яров?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Она замирает. Ветошь падает на пол.",
                    "action": true,
                    "voice": "assets/voice/narr_ira_3.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Он в ночную сменился. Тринадцатого. Сказал — к утру вернётся.",
                    "voice": "assets/voice/ira_8.mp3"
                  }
                }
              ]
            }
          ],
          "goto": "Брат",
          "conds": [
            {
              "type": "flag",
              "flag": "clue_guard"
            },
            {
              "type": "flag",
              "flag": "ira_told_brother",
              "not": true
            }
          ],
          "once": true
        },
        {
          "text": "Я нашёл его жетон.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Она берёт жетон двумя руками, как воду.",
                    "action": true,
                    "sfx": "snd_tag",
                    "voice": "assets/voice/narr_ira_4.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Спасибо. За то, что не написал «погиб при исполнении». Он не при исполнении.",
                    "voice": "assets/voice/ira_3.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ira_brother"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "has_item",
              "item": "item_guard_token"
            },
            {
              "type": "flag",
              "flag": "ira_told_brother"
            },
            {
              "type": "flag",
              "flag": "ira_saw_body",
              "not": true
            }
          ],
          "once": true
        },
        {
          "text": "Возьми жетон Стася. Он твой.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Она берёт жетон двумя руками, как воду.",
                    "action": true,
                    "sfx": "snd_tag",
                    "voice": "assets/voice/narr_ira_4.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Спасибо. За то, что не написал «погиб при исполнении». Он не при исполнении.",
                    "voice": "assets/voice/ira_3.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ira_brother"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "has_item",
              "item": "item_guard_token"
            },
            {
              "type": "flag",
              "flag": "ira_saw_body"
            }
          ],
          "once": true
        },
        {
          "text": "Векс записал: вниз ушли двенадцать, вернулись одиннадцать.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ira_journal"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Она долго молчит, сжимая ветошь в кулаке.",
                    "action": true,
                    "voice": "assets/voice/narr_ira_9.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Одиннадцать. Значит, его не забыли записать. Его не вернули.",
                    "emotion": "sad",
                    "voice": "assets/voice/ira_18.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Келл сказал матери — перевели на другой ярус. На другой ярус без записи не переводят.",
                    "emotion": "angry",
                    "voice": "assets/voice/ira_19.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 6
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true,
          "conds": [
            {
              "type": "flag",
              "flag": "ira_journal",
              "not": true
            },
            {
              "type": "flag",
              "flag": "vex_journal"
            },
            {
              "type": "flag",
              "flag": "ira_told_brother"
            }
          ]
        },
        {
          "text": "Векс говорит: сводки о воде пишут под диктовку.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ira_gauge"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Я это по помпе слышала раньше, чем он по рейке. Когда привод стоит, вода стабильной не бывает. Стабильной бывает только ложь.",
                    "emotion": "angry",
                    "voice": "assets/voice/ira_20.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 4
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true,
          "conds": [
            {
              "type": "flag",
              "flag": "ira_gauge",
              "not": true
            },
            {
              "type": "flag",
              "flag": "vex_job_done"
            }
          ]
        },
        {
          "text": "Кто, по-твоему, остановил помпу?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Кто-то, кому выгодно, чтобы восьмой затопило.",
                    "voice": "assets/voice/ira_10.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Надзор два года просил Цех отдать девятый ярус. Теперь он ничей — и под водой.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/ira_5.mp3"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Пойдём со мной. Здесь тебя не защитят.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Она кивает раньше, чем ты договорил.",
                    "action": true,
                    "voice": "assets/voice/narr_ira_5.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Только возьму фонарь. И ключ от затвора — у помощницы мастера он свой.",
                    "voice": "assets/voice/ira_9.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ira_joins"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "ira_joined",
              "not": true
            },
            {
              "type": "disp_ge",
              "target": "npc_ira",
              "value": 25
            }
          ]
        },
        {
          "text": "Показать рукавицу с привода.",
          "conds": [
            {
              "type": "flag",
              "flag": "ira_glove",
              "not": true
            },
            {
              "type": "has_item",
              "item": "item_glove"
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ira_glove"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Она берёт рукавицу за манжет двумя пальцами, как чужую вещь.",
                    "action": true,
                    "voice": "assets/voice/narr_ira_6.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Реш носил кожаные и жаловался, что они жмут. А заплату ставили в Сухом ряду: у Айлы так штопают, когда нечем платить.",
                    "voice": "assets/voice/ira_16.mp3",
                    "emotion": "thoughtful",
                    "sfx": "snd_cloth"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 4
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "learn_name",
                    "entity": "npc_ayla"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Ранец из галереи. Бирка: «Смена 13-го. Ярус 8». Чей он?",
          "conds": [
            {
              "type": "flag",
              "flag": "pack_tag"
            },
            {
              "type": "flag",
              "flag": "ira_pack",
              "not": true
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ira_pack"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Лямку узлом он вязал. Устав велит пряжкой, а Стась говорил: пряжка на бегу расстёгивается. Это его ранец.",
                    "voice": "assets/voice/ira_28.mp3",
                    "emotion": "sad"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Паёк и флягу бросил... Значит, не прятался. Бежал к затвору — закрывать воду, пока ещё можно было.",
                    "voice": "assets/voice/ira_29.mp3",
                    "emotion": "thoughtful"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 4
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ira_pack"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Показать клапан из шахты.",
          "conds": [
            {
              "type": "has_item",
              "item": "item_valve"
            },
            {
              "type": "flag",
              "flag": "ira_valve",
              "not": true
            },
            {
              "type": "flag",
              "flag": "sluice_ready",
              "not": true
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ira_valve"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Она проводит пальцем по выбитой семёрке.",
                    "action": true,
                    "sfx": "snd_tag",
                    "voice": "assets/voice/narr_ira_15.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Седьмой номер — с нашего затвора. Резьба целая: его не сорвало водой, его вывернули ключом. Неси на восьмой, к затвору, пока там ещё есть что закрывать.",
                    "voice": "assets/voice/ira_31.mp3",
                    "emotion": "thoughtful"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 3
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ira_valve"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Пойдём со мной снова.",
          "conds": [
            {
              "type": "flag",
              "flag": "ira_joined"
            },
            {
              "type": "in_party",
              "npc": "npc_ira",
              "not": true
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Опять вниз? Пойдём. Фонарь я так и не выпустила из рук.",
                    "voice": "assets/voice/ira_38.mp3",
                    "emotion": "calm"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "join_party",
                    "npc": "npc_ira"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_description",
                    "entity": "npc_ira",
                    "text": "Помощница мастера, пошедшая с дознавателем. Знает помпу по звуку и не верит бумагам."
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Как ты держишься?",
          "conds": [
            {
              "type": "in_party",
              "npc": "npc_ira"
            }
          ],
          "sections": [
            {
              "conds": [
                {
                  "type": "flag",
                  "flag": "ira_worn"
                }
              ],
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Ноги сами идут, а голова уже нет. Дай поесть или дай поспать — что-нибудь одно, я не гордая.",
                    "voice": "assets/voice/ira_35.mp3",
                    "emotion": "tired"
                  }
                }
              ],
              "else_steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Держусь. Пока ты идёшь — и я иду. Только фонарь у меня, так что не убегай вперёд.",
                    "voice": "assets/voice/ira_36.mp3",
                    "emotion": "calm"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Возвращайся к пульту. Дальше я сам.",
          "conds": [
            {
              "type": "in_party",
              "npc": "npc_ira"
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Ладно, вернусь к пульту. Только не пропадай там внизу, как он.",
                    "voice": "assets/voice/ira_37.mp3",
                    "emotion": "sad"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "leave_party",
                    "npc": "npc_ira"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ira_returns_card"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_description",
                    "entity": "npc_ira",
                    "text": "Помощница мастера. Ходила с дознавателем вниз, теперь снова ждёт у пульта."
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Мне пора.",
          "sections": [],
          "goto": "end",
          "conds": [
            {
              "type": "in_party",
              "npc": "npc_ira",
              "not": true
            }
          ]
        },
        {
          "text": "Идём дальше.",
          "conds": [
            {
              "type": "in_party",
              "npc": "npc_ira"
            }
          ],
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "Брат",
      "label": "Разговор о брате",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Она поднимает ветошь, но не вытирает руки.",
                "action": true,
                "voice": "assets/voice/narr_ira_7.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Говори. Ты же не просто так спросил. Каждый вопрос здесь чего-нибудь стоит. Моего времени, например.",
                "voice": "assets/voice/ira_14.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Только не говори «погиб». Матери сказали — перевели на другой ярус. Пусть это ещё побудет правдой.",
                "voice": "assets/voice/ira_15.mp3"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "ira_told_brother"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Он не вышел со смены. Я нашёл тело у затвора.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Значит, он всё-таки закрывал затвор. Его послали туда, где он умел.",
                    "emotion": "sad",
                    "voice": "assets/voice/ira_7.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 12
                  }
                }
              ]
            }
          ],
          "goto": "Начало",
          "once": true
        },
        {
          "text": "Я найду того, кто это сделал.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Не надо «найду». Надо «назову». Назови имя, и я поверю.",
                    "emotion": "angry",
                    "voice": "assets/voice/ira_6.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 8
                  }
                }
              ]
            }
          ],
          "goto": "Начало",
          "once": true
        },
        {
          "text": "Я не знал его. Прости.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Никто его не знал. Он стоял внизу, когда все спали. Вот и всё.",
                    "emotion": "sad",
                    "voice": "assets/voice/ira_11.mp3"
                  }
                }
              ]
            }
          ],
          "goto": "Начало",
          "once": true
        }
      ],
      "timer": {
        "seconds": 18,
        "node": "Молчание"
      }
    },
    {
      "id": "Молчание",
      "label": "Молчание",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Ты молчишь. Она ждёт — и поднимает ветошь с пола.",
                "action": true,
                "voice": "assets/voice/narr_ira_8.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Вот и я молчу третий день. Ничего, привыкла.",
                "voice": "assets/voice/ira_17.mp3"
              }
            }
          ]
        }
      ],
      "choices": [],
      "goto": "end"
    },
    {
      "id": "У_затвора",
      "label": "Ира у затвора (отряд)",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Ира останавливается у края воды и долго смотрит на штурвал. Ключ в её руке висит, как лишний.",
                "action": true,
                "sfx": "sfx_water",
                "voice": "assets/voice/narr_ira_10.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Стась здесь стоял каждую смену. Говорил: затвор — как сердце. Пока ходит, ярус живёт.",
                "emotion": "sad",
                "voice": "assets/voice/ira_21.mp3"
              }
            }
          ]
        },
        {
          "conds": [
            {
              "type": "flag",
              "flag": "clue_guard"
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "А его здесь оставили. Одного, у воды. Свои оставили.",
                "emotion": "angry",
                "voice": "assets/voice/ira_22.mp3"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Мы закончим то, что он не успел.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Тогда по-честному. Чтобы в отчёте стояло его имя, а не «пропал без вести».",
                    "emotion": "calm",
                    "voice": "assets/voice/ira_23.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 5
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true,
          "conds": []
        },
        {
          "text": "Ты знаешь, как он устроен?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "ira_rig_tip"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Стась показывал. Под нижними мостками есть ригель. К нему можно подойти по воде, и сверху тебя не видно. Он там от старшины прятался, когда курил.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/ira_24.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_ira_rig_tip"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true,
          "conds": [
            {
              "type": "flag",
              "flag": "ira_rig_tip",
              "not": true
            }
          ]
        },
        {
          "text": "Пойдём.",
          "sections": [],
          "goto": "end",
          "conds": []
        }
      ]
    },
    {
      "id": "В_штольне",
      "label": "Ира в штольне (отряд)",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Ира поднимает фонарь и замирает. Из-за крепи доносится тонкий звон, будто кто-то ведёт пальцем по краю стакана.",
                "action": true,
                "sfx": "sfx_hum",
                "voice": "assets/voice/narr_ira_11.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Слышишь? Отец говорил: жила поёт тем, кто стоит к ней слишком долго. Не стой долго.",
                "emotion": "afraid",
                "voice": "assets/voice/ira_25.mp3"
              }
            }
          ]
        },
        {
          "conds": [
            {
              "type": "has_item",
              "item": "item_vein_shard"
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "И от тебя звенит. Ты носишь стекляшку того, с гогглами? Выбрось, пока она тебя не выбрала.",
                "emotion": "angry",
                "voice": "assets/voice/ira_27.mp3"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Что ещё говорил твой отец?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Что жилу не продают. Её либо закрывают, либо она закрывает тебя. Он закрыл одну, на седьмом. Потом кашлял до последнего дня.",
                    "emotion": "sad",
                    "voice": "assets/voice/ira_26.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 3
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_vein"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true,
          "conds": []
        },
        {
          "text": "Пойдём.",
          "sections": [],
          "goto": "end",
          "conds": []
        }
      ]
    },
    {
      "id": "У_тела",
      "label": "Ира у тела брата (отряд)",
      "sections": [
        {
          "steps": [
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "ira_saw_body"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "ira_told_brother"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Ира опускает фонарь. Свет ложится на казённую куртку и на сорванную цепочку в сведённых пальцах.",
                "action": true,
                "voice": "assets/voice/narr_ira_12.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Не свети ему в лицо, я и так знаю, кто это. Матери сказали — перевели на другой ярус. Вот он, другой ярус.",
                "voice": "assets/voice/ira_32.mp3",
                "emotion": "sad"
              }
            }
          ]
        }
      ],
      "timer": {
        "seconds": 12,
        "node": "У_тела_молчание"
      },
      "choices": [
        {
          "text": "Мне жаль, Ира.",
          "once": true,
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Не жалей. Запомни, как он лежит и что у него в пальцах. Теперь это улика, а не брат.",
                    "voice": "assets/voice/ira_33.mp3",
                    "emotion": "angry"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 8
                  }
                }
              ]
            }
          ],
          "goto": "У_тела_конец"
        },
        {
          "text": "Он держал затвор до последнего.",
          "once": true,
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Знал, что вода пойдёт, и всё равно стоял. Только ударили его сзади. Вода так не бьёт.",
                    "voice": "assets/voice/ira_34.mp3",
                    "emotion": "sad"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_ira",
                    "delta": 10
                  }
                }
              ]
            }
          ],
          "goto": "У_тела_конец"
        }
      ]
    },
    {
      "id": "У_тела_молчание",
      "label": "Ира молчит у тела",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Ира стоит над братом, пока фонарь в её руке не перестаёт дрожать.",
                "action": true,
                "voice": "assets/voice/narr_ira_13.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Вот и я молчу третий день. Ничего, привыкла.",
                "voice": "assets/voice/ira_17.mp3",
                "emotion": "sad"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "change_disposition",
                "target": "npc_ira",
                "delta": 4
              }
            }
          ]
        }
      ],
      "goto": "У_тела_конец",
      "choices": []
    },
    {
      "id": "У_тела_конец",
      "label": "Конец сцены у тела",
      "sections": [
        {
          "steps": [
            {
              "kind": "effect",
              "effect": {
                "type": "fire_rule",
                "rule": "rule_ira_body_card"
              }
            }
          ]
        }
      ],
      "goto": "end",
      "choices": []
    }
  ]
}
