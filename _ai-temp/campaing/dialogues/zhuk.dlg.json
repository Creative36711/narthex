{
  "version": 2,
  "label": "Жук, информатор",
  "nodes": [
    {
      "id": "Начало",
      "label": "Начало разговора",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Жук не здоровается. Он просто ждёт, сколько ты заплатишь.",
                "action": true
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Слушаю. Дорого."
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Что ты видел в ночь тринадцатого?",
          "sections": [],
          "goto": "stay",
          "check": {
            "skill": "persuade",
            "difficulty": 50,
            "success": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Келл со взводом, двенадцать человек, вниз — и ни одного обратно до утра. Ещё: мастер выходил из шахты не один. Но это ты не от меня слышал."
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "set_flag",
                        "flag": "zhuk_paid"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "fire_rule",
                        "rule": "rule_zhuk_info"
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            },
            "fail": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Видел я много. Рассказываю — мало. Пятьдесят марок, и я вспомню всё."
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            }
          }
        },
        {
          "text": "Пятьдесят марок. Вспоминай.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Он протягивает руку, не глядя. Марки исчезают в рукаве.",
                    "action": true
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Стража Келла, двенадцать человек, вниз. Мастер — наверх, потом снова вниз, с сердцевиной в сумке. А наряд в архиве подшит к делу тринадцать-К: без пломбы тебе его не дадут."
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "remove_item",
                    "item": "item_mark",
                    "qty": 50
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_zhuk_info"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "item_ge",
              "item": "item_mark",
              "count": 50
            },
            {
              "type": "flag",
              "flag": "zhuk_paid",
              "not": true
            }
          ]
        },
        {
          "text": "Кто заказал остановку помпы?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Не Келл. Келл — руки, а руки дешёвые. Бумага дорогая.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/zhuk_1.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Ищи, кто подписал расход на режим тишины. Кто подписал, тот и заказал.",
                    "voice": "assets/voice/zhuk_2.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "kast_alerted"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "zhuk_paid"
            }
          ]
        },
        {
          "text": "Ты и сам знаешь, кто стоял. Что ещё?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Жук кривится, но рук не прячет: тогда слушай другое. Гроссбух он не в конторе держал и не в каморке: он его в штольне спрятал, там, где спал, под плитой. Ищи, где у мастера была постель.",
                    "emotion": "thoughtful"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "zhuk_cache_hint"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "clue_roster"
            },
            {
              "type": "flag",
              "flag": "zhuk_cache_hint",
              "not": true
            }
          ]
        },
        {
          "text": "Дать Жуку полистать гроссбух.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "present_item",
                    "required": "item_ledger",
                    "ok_goto": "Расход",
                    "fail_goto": "Отказ"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Где мастер?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Ниже восьмого. Там, где жила поёт. Хочешь — спускайся, хочешь — живи.",
                    "emotion": "calm",
                    "voice": "assets/voice/zhuk_3.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_reveal_deep"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Пока.",
          "sections": [],
          "goto": "end"
        }
      ],
      "timer": {
        "seconds": 15,
        "node": "Молчание"
      }
    },
    {
      "id": "Молчание",
      "label": "Молчание",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Жук ждёт ровно столько, сколько стоит твоё молчание.",
                "action": true
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Молчишь? Значит, не заплатишь. Бывай."
              }
            }
          ]
        }
      ],
      "choices": [],
      "goto": "Начало"
    },
    {
      "id": "Расход",
      "speaker": "zhuk",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Жук листает, водя пальцем по столбцам, и считает тихо, одними губами.",
                "action": true,
                "timer": 5
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Мазут списан на семь смен по двенадцать человек. А тринадцатая ночь в расходе есть, людей в ней нет.",
                "emotion": "thoughtful",
                "voice": "assets/voice/zhuk_4.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Кто-то платил, чтобы седьмой ярус в ту ночь стоял пустым. Платил не Келл: у Келла таких денег нет, у него только руки.",
                "emotion": "thoughtful"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "zhuk_ledger"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "change_disposition",
                "target": "npc_zhuk",
                "delta": 8
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "fire_rule",
                "rule": "rule_zhuk_ledger"
              }
            }
          ]
        }
      ],
      "choices": []
    },
    {
      "id": "Отказ",
      "speaker": "zhuk",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Жук вертит вещь в пальцах и возвращает.",
                "action": true
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "За это Векс и лома не даст. Приходи с бумагой, а лучше — с гроссбухом.",
                "emotion": "calm"
              }
            }
          ]
        }
      ],
      "choices": []
    }
  ]
}
