      },
      {
       "kind": "line",
       "line": {
        "text": "Вещь стоящая — для того, кто её ищет. Я таких не знаю, но за полцены возьму.",
        "emotion": "calm",
        "voice": "assets/voice/dozh_6.mp3"
       }
      },
      {
       "kind": "effect",
       "effect": {
        "type": "change_disposition",
        "delta": 2,
        "target": "npc_dozh"
       }
      }
     ]
