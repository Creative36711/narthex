{
  "version": 2,
  "label": "Дож, старьёвщик",
  "nodes": [
    {
      "id": "Начало",
      "label": "Начало разговора",
      "sections": [
        {
          "conds": [
            {
              "type": "flag",
              "flag": "met_dozh"
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Дож узнаёт тебя и молча кивает на прилавок.",
                "action": true,
                "voice": "assets/voice/narr_dozh_rep.mp3"
              }
            }
          ],
          "else_steps": [
            {
              "kind": "line",
              "line": {
                "text": "Дож что-то взвешивает на ладони и прячет в рукав, не глядя.",
                "action": true,
                "voice": "assets/voice/narr_dozh_1.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Смотри, не покупатель. С покупателями я вежливей.",
                "voice": "assets/voice/dozh_4.mp3"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "learn_name",
                "entity": "npc_dozh",
                "silent": true
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "met_dozh"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Торговать.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Ну наконец-то. Смотри, не трогай руками: руками только платят.",
                    "emotion": "calm",
                    "voice": "assets/voice/dozh_10.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "open_trade",
                    "npc": "npc_dozh"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Что слышно про помпу?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Слышно, что она молчит. А про молчание внизу всегда слышно громче.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/dozh_1.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Говорят, на девятом жилу нашли. Живую. Говорят, из-за неё всё.",
                    "voice": "assets/voice/dozh_3.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_karkas"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Кто там сидит у жаровни?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "dozh_who"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Жук у жаровни сидит. Греется, как честный человек.",
                    "emotion": "calm",
                    "voice": "assets/voice/dozh_8.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Скажи, что от Дожа. Он скинет — не много, но скинет.",
                    "voice": "assets/voice/dozh_9.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_zhuk",
                    "delta": 8
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "learn_name",
                    "entity": "npc_zhuk"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true,
          "conds": [
            {
              "type": "flag",
              "flag": "dozh_who",
              "not": true
            }
          ]
        },
        {
          "text": "Купить дыхатель (34 марки).",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Дыхатель — это не товар, это время. Держи, не задохнись.",
                    "emotion": "calm",
                    "voice": "assets/voice/dozh_2.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "remove_item",
                    "item": "item_mark",
                    "qty": 34
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "add_item",
                    "item": "item_filter",
                    "qty": 1
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "item_ge",
              "item": "item_mark",
              "count": 34
            },
            {
              "type": "has_item",
              "item": "item_filter",
              "not": true
            }
          ]
        },
        {
          "text": "Показать Дожу вещь.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "present_item",
                    "ok": "Оценка",
                    "fail": "Оценка_мимо"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Что берут с собой те, кто ходит ниже восьмого?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "dozh_kit"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Дож оглядывает тебя, как товар, который не продаётся.",
                    "action": true,
                    "voice": "assets/voice/narr_dozh_5.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Гнилец медленный, но крепкий: пока он идёт, бей издалека. Самострел у меня один, болты — по две марки.",
                    "emotion": "calm",
                    "voice": "assets/voice/dozh_15.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Пёс быстрый, а держит плохо: не беги от него, бей в ответ. И с голой грудью вниз не ходи — жилеты у людей Келла хорошие, только снимают их с себя неохотно.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/dozh_16.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_dozh",
                    "delta": 2
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true,
          "conds": [
            {
              "type": "flag",
              "flag": "dozh_kit",
              "not": true
            }
          ]
        },
        {
          "text": "Как тут таскают тяжёлое?",
          "conds": [
            {
              "type": "flag",
              "flag": "dozh_back",
              "not": true
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "dozh_back"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_porters"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Тяжёлое тут таскают на горбу, а горб у каждого один. Кто нагрузится сверх меры, тот идёт вдвое дольше — и дышит вдвое чаще.",
                    "voice": "assets/voice/dozh_17.mp3",
                    "emotion": "thoughtful"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Возьми короб: плетёный, на ремнях, с ним ещё девять кило унесёшь. Восемнадцать марок — дешевле, чем надорваться.",
                    "voice": "assets/voice/dozh_18.mp3",
                    "emotion": "calm"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Векс прислал тебе уголь.",
          "conds": [
            {
              "type": "has_item",
              "item": "item_coal_sack"
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_coal_delivered"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Почему у тебя всё дороже, чем наверху?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Потому что сверху вещи возят, а сюда их носят на себе. Спина — тоже цена.",
                    "emotion": "calm",
                    "voice": "assets/voice/dozh_5.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Уголь — три марки штука, и это ещё по-людски. Как вода пришла, уголь у нас дороже воды стал. Ведром не продаю: ведро самому топить.",
                    "emotion": "calm",
                    "voice": "assets/voice/dozh_14.mp3"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Пока.",
          "sections": [],
          "goto": "end"
        }
      ],
      "timer": {
        "seconds": 20,
        "node": "Молчание"
      }
    },
    {
      "id": "Молчание",
      "label": "Молчание",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Дож спокойно ждёт: он умеет торговать и молча.",
                "action": true,
                "voice": "assets/voice/narr_dozh_2.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Молчишь? И правильно. Кто говорит, тот уже купил.",
                "voice": "assets/voice/dozh_7.mp3"
              }
            }
          ]
        }
      ],
      "choices": [],
      "goto": "end"
    },
    {
      "id": "Оценка",
      "label": "Дож смотрит вещь",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Дож вертит вещь двумя пальцами, прищурившись.",
                "action": true,
                "sfx": "snd_latch",
                "voice": "assets/voice/narr_dozh_3.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Вещь стоящая — для того, кто её ищет. Я таких не знаю, но за полцены возьму.",
                "emotion": "calm",
                "voice": "assets/voice/dozh_6.mp3"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "change_disposition",
                "delta": 2,
                "target": "npc_dozh"
              }
            }
          ]
        }
      ],
      "goto": "Начало",
      "choices": []
    },
    {
      "id": "Оценка_мимо",
      "label": "Пустые руки",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Дож разводит руками: пусто.",
                "action": true,
                "voice": "assets/voice/narr_dozh_4.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Руки показывай, когда они полные. Пустыми торгуют только нищие.",
                "emotion": "calm",
                "voice": "assets/voice/dozh_11.mp3"
              }
            }
          ]
        }
      ],
      "goto": "Начало",
      "choices": []
    }
  ]
}
