{
 "version": 2,
 "label": "Регистратор архива",
 "nodes": [
  {
   "id": "Начало",
   "label": "Начало разговора",
   "sections": [
    {
     "steps": [
      {
       "kind": "line",
       "line": {
        "text": "Регистратор щёлкает реле: два стеклянных глаза разгораются бирюзой.",
        "action": true,
        "sfx": "sfx_click"
       }
      },
      {
       "kind": "line",
       "line": {
        "text": "Назовите номер дела, шифр или дату. Говорите чётко: я пишу, как слышу.",
        "voice": "assets/voice/registrar_1.mp3",
        "sfx": "sfx_tick"
       }
      },
      {
       "kind": "line",
       "line": {
        "text": "Срок дознания по делу сто тридцать семь — семьдесят два часа. Он идёт, пока вы стоите и молчите.",
        "voice": "assets/voice/registrar_8.mp3"
       }
      },
      {
       "kind": "line",
       "line": {
        "text": "Срок дознания не продлевают. Его переписывают — и в новой бумаге он идёт сначала. Так что спешите с первой, а не со второй.",
        "voice": "assets/voice/registrar_9.mp3"
       }
      }
     ]
    }
   ],
   "choices": [
    {
     "text": "Дело сто тридцать шесть.",
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Дело сто тридцать шесть. Затопление девятого яруса. Исполнено. Подпись: инспектор Каст.",
          "emotion": "calm",
          "voice": "assets/voice/registrar_2.mp3"
         }
        },
        {
         "kind": "effect",
         "effect": {
          "type": "unlock_codex",
          "entry": "codex_case136"
         }
        }
       ]
      }
     ],
     "goto": "stay",
     "once": true
    },
    {
     "text": "Наряд стражи за ночь тринадцатого.",
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Пломба предъявлена. Выдаю.",
          "emotion": "calm",
          "voice": "assets/voice/registrar_4.mp3",
          "sfx": "snd_latch"
         }
        },
        {
         "kind": "line",
         "line": {
          "text": "Взвод старшины Келла Ястреба, двенадцать человек, седьмой ярус, с двадцати до шести. Пометки о смене нет.",
          "voice": "assets/voice/registrar_5.mp3"
         }
        },
        {
         "kind": "effect",
         "effect": {
          "type": "add_item",
          "item": "item_roster",
          "qty": 1
         }
        },
        {
         "kind": "effect",
         "effect": {
          "type": "fire_rule",
          "rule": "rule_roster_got"
         }
        },
        {
         "kind": "effect",
         "effect": {
          "type": "advance_time",
          "ticks": 1
         }
        }
       ]
      }
     ],
     "goto": "stay",
     "conds": [
      {
       "type": "has_item",
       "item": "item_plate",
       "not": true
      }
     ]
    },
    {
     "text": "Наряд стражи за ночь тринадцатого.",
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Пломба не предъявлена. Наряды без пломбы не выдаются.",
          "emotion": "calm",
          "sfx": "sfx_error",
          "voice": "assets/voice/registrar_7.mp3"
         }
        }
       ]
      }
     ],
     "goto": "stay",
     "conds": [
      {
       "type": "has_item",
       "item": "item_plate",
       "not": true
      }
     ]
    },
    {
     "text": "Ведомость седьмой помпы.",
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Расход мазута, смены мастера Реша Э. Пометка: «режим тишины — см. приложение». Приложение изъято.",
          "emotion": "calm",
          "voice": "assets/voice/registrar_3.mp3"
         }
        }
       ]
      }
     ],
     "goto": "stay"
    },
    {
     "text": "Кто изъял приложение?",
     "sections": [
      {
       "steps": [
        {
         "kind": "line",
         "line": {
          "text": "Инспектор Каст В. Основание: пункт девятый. Пункт девятый гласит: «в интересах яруса».",
          "emotion": "calm",
          "voice": "assets/voice/registrar_6.mp3"
         }
        },
        {
         "kind": "effect",
         "effect": {
          "type": "set_flag",
          "flag": "kast_alerted"
         }
        }
       ]
      }
     ],
     "goto": "stay"
    },
    {
     "text": "Отключись.",
     "sections": [],
     "goto": "end"
    }
   ]
  }
 ]
}