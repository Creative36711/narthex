{
  "version": 2,
  "label": "Келл Ястреб, старшина стражи",
  "nodes": [
    {
      "id": "Начало",
      "label": "Начало разговора",
      "sections": [
        {
          "conds": [
            {
              "type": "flag",
              "flag": "met_kell"
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Келл узнаёт тебя и не убирает руки с рукояти.",
                "action": true,
                "voice": "assets/voice/narr_kell_rep.mp3"
              }
            }
          ],
          "else_steps": [
            {
              "kind": "line",
              "line": {
                "text": "Келл не встаёт. Он просто кладёт руку на рукоять клинка.",
                "action": true,
                "sfx": "snd_blade",
                "voice": "assets/voice/narr_kell_1.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Дознаватель. Я тебя не вызывал.",
                "voice": "assets/voice/kell_6.mp3"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "met_kell"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Где ты был в ночь тринадцатого?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "kell_asked13"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "check": {
            "skill": "intimidate",
            "difficulty": 50,
            "success": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "На седьмом. Стоял, как велено. Двенадцать человек, все в журнале — спроси у Векса, он записывал.",
                        "voice": "assets/voice/kell_11.mp3"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "npc_kell",
                        "delta": -6
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "set_flag",
                        "flag": "kell_pressed"
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            },
            "fail": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Ты меня допрашиваешь? Забавно. У тебя бумага, у меня двенадцать свидетелей, которые стояли со мной.",
                        "voice": "assets/voice/kell_14.mp3"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "npc_kell",
                        "delta": -10
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            }
          },
          "once": true,
          "conds": [
            {
              "type": "flag",
              "flag": "kell_asked13",
              "not": true
            }
          ]
        },
        {
          "text": "Что такое режим тишины?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Это когда ярус закрывают и считают, сколько в нём осталось людей.",
                    "emotion": "calm",
                    "voice": "assets/voice/kell_2.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Хорошая вещь, если ты не из тех, кого считают.",
                    "emotion": "calm",
                    "voice": "assets/voice/kell_12.mp3"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Ты убил стража Ярова.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "kell_accused"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "kell_accused",
              "not": true
            },
            {
              "type": "flag",
              "flag": "clue_guard"
            }
          ],
          "check": {
            "skill": "intimidate",
            "difficulty": 55,
            "success": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Не я. Приказ есть приказ: закрыть затвор, никого не выпускать. Он не послушал. Я не спрашивал, почему.",
                        "voice": "assets/voice/kell_3.mp3"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "set_flag",
                        "flag": "kell_confessed"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "npc_kell",
                        "delta": -20
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "faction_nadzor",
                        "delta": -15
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            },
            "fail": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "За такие слова внизу не отвечают. Считай, я не слышал — пока ты при исполнении.",
                        "voice": "assets/voice/kell_15.mp3"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "npc_kell",
                        "delta": -8
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            }
          },
          "once": true
        },
        {
          "text": "Наряд тринадцатого: твой взвод ушёл вниз, а по бумагам стоял на седьмом.",
          "conds": [
            {
              "type": "has_item",
              "item": "item_roster"
            },
            {
              "type": "flag",
              "flag": "kell_confessed",
              "not": true
            },
            {
              "type": "flag",
              "flag": "vex_journal"
            }
          ],
          "sections": [],
          "goto": "Наряд"
        },
        {
          "text": "Наряд тринадцатого: твой взвод ушёл вниз, а по бумагам стоял на седьмом.",
          "conds": [
            {
              "type": "has_item",
              "item": "item_roster"
            },
            {
              "type": "flag",
              "flag": "kell_confessed",
              "not": true
            },
            {
              "type": "flag",
              "flag": "clue_guard"
            },
            {
              "type": "flag",
              "flag": "vex_journal",
              "not": true
            }
          ],
          "sections": [],
          "goto": "Наряд"
        },
        {
          "text": "Положить перед Келлом находку у затвора.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "present_item",
                    "ok": "Жетон",
                    "fail": "Жетон_мимо",
                    "required": "item_guard_token"
                  }
                }
              ]
            }
          ],
          "goto": "end",
          "conds": [
            {
              "type": "flag",
              "flag": "clue_guard"
            },
            {
              "type": "flag",
              "flag": "kell_token",
              "not": true
            }
          ]
        },
        {
          "text": "Пропусти меня к помпе.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Помпа не моя. Иди, смотри. Только вниз не суйся: там не наша вода.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/kell_1.mp3"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Я иду к инспектору.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Иди. Она любит, когда к ней идут с пустыми руками.",
                    "emotion": "calm",
                    "voice": "assets/voice/kell_10.mp3"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Показать находку с привода.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "present_item",
                    "ok": "Рукавица",
                    "fail": "Жетон_мимо",
                    "required": "item_glove"
                  }
                }
              ]
            }
          ],
          "goto": "end",
          "conds": [
            {
              "type": "flag",
              "flag": "clue_glove"
            },
            {
              "type": "flag",
              "flag": "kell_glove",
              "not": true
            }
          ]
        }
      ]
    },
    {
      "id": "Наряд",
      "label": "Наряд тринадцатого",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Он смотрит на бумагу долго, потом убирает руку с рукояти.",
                "action": true,
                "voice": "assets/voice/narr_kell_3.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Двенадцать человек, седьмой ярус, с двадцати до шести. Моя подпись стоит второй.",
                "emotion": "thoughtful",
                "voice": "assets/voice/kell_4.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Первую подпись ты уже видел. Старшина — это только руки, дознаватель. Бумагу подписывают не руки.",
                "voice": "assets/voice/kell_9.mp3"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "clue_roster"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "kell_confessed"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "change_disposition",
                "target": "npc_kell",
                "delta": -10
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "unlock_codex",
                "entry": "codex_silence"
              }
            }
          ]
        }
      ],
      "choices": [],
      "goto": "Начало"
    },
    {
      "id": "Жетон",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Келл смотрит на медь так, будто она горячая, и не берёт.",
                "action": true,
                "sfx": "snd_tag",
                "voice": "assets/voice/narr_kell_4.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Яров. Значит, вода сошла у затвора, и ты нашёл его у решётки. Я три дня не смел зайти к его сестре.",
                "emotion": "sad",
                "voice": "assets/voice/kell_5.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Отдай ей сам. И скажи: Келл стоял у затвора и не открыл. Это правда, и она хуже любой лжи, которую ты мог бы придумать.",
                "emotion": "thoughtful",
                "voice": "assets/voice/kell_7.mp3"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "kell_token"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "change_disposition",
                "target": "npc_kell",
                "delta": 10
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "fire_rule",
                "rule": "rule_kell_token"
              }
            }
          ]
        }
      ],
      "label": "Жетон Ярова",
      "choices": [],
      "goto": "Начало"
    },
    {
      "id": "Жетон_мимо",
      "label": "Не та вещь",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Келл смотрит сначала на вещь, потом на тебя — и без всякого интереса.",
                "action": true,
                "voice": "assets/voice/narr_kell_5.mp3"
              }
            }
          ]
        }
      ],
      "goto": "Начало",
      "choices": []
    },
    {
      "id": "Рукавица",
      "label": "Рукавица с привода",
      "sections": [
        {
          "steps": [
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "kell_glove"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Он берёт рукавицу за манжет, не разворачивая.",
                "action": true,
                "voice": "assets/voice/narr_kell_2.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Рукавица. В машинном зале их сто пар лежит: смене выдают по две на руки. Клади в дело, раз нравится. Мне интереснее, кто её первым снимет.",
                "voice": "assets/voice/kell_13.mp3",
                "emotion": "calm",
                "sfx": "snd_cloth"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "change_disposition",
                "target": "npc_kell",
                "delta": -3
              }
            }
          ]
        }
      ],
      "goto": "Начало",
      "choices": []
    }
  ]
}