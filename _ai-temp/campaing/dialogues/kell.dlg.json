         ]
        }
       ],
       "goto": "stay"
      },
      "fail": {
       "sections": [
        {
         "steps": [
          {
           "kind": "line",
           "line": {
            "text": "Ты меня допрашиваешь? Забавно. У тебя бумага, у меня двенадцать свидетелей, которые стояли со мной."
           }
          },
          {
           "kind": "effect",
           "effect": {
            "type": "change_disposition",
            "target": "npc_kell",
            "delta": -10
