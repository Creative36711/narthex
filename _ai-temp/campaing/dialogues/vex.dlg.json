{
  "version": 2,
  "label": "Векс, смотритель шлюза",
  "nodes": [
    {
      "id": "Начало",
      "label": "Начало разговора",
      "sections": [
        {
          "conds": [
            {
              "type": "flag",
              "flag": "met_vex"
            }
          ],
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Векс кивает от пульта, не прерывая записи в журнале.",
                "action": true,
                "voice": "assets/voice/narr_vex_rep.mp3"
              }
            }
          ],
          "else_steps": [
            {
              "kind": "effect",
              "effect": {
                "type": "learn_name",
                "entity": "npc_vex",
                "silent": true
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Векс поднимает глаза от пульта и долго смотрит на твой жетон.",
                "action": true,
                "sfx": "sfx_click",
                "voice": "assets/voice/narr_vex_1.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Приписной дознаватель? Проходи в контору за дверью, там печка топится. Здесь у затвора только сквозняк и чужие.",
                "voice": "assets/voice/vex_1.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Я своим журналом отвечаю за каждого, кто прошёл.",
                "voice": "assets/voice/vex_2.mp3"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Журнал врёт редко. Чаще его просто не дописывают до конца смены.",
                "voice": "assets/voice/vex_10.mp3"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "met_vex"
              }
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Что с седьмой помпой?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Стоит. Третий день стоит. Механики приходили, слушали, уходили, а вода всё прибывает.",
                    "voice": "assets/voice/vex_5.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Он крутит маховик на четверть оборота — тот идёт свободно, как в пустоте.",
                    "action": true,
                    "sfx": "sfx_gear",
                    "voice": "assets/voice/narr_vex_2.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Мастер твой Реш спустился в шахту в восемнадцать сорок. Я его сам записал. Обратно — не записал.",
                    "voice": "assets/voice/vex_3.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_pumps"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "in_party",
              "npc": "npc_resh",
              "not": true
            }
          ]
        },
        {
          "text": "Что с седьмой помпой?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Стоит. Третий день стоит. Механики приходили, слушали, уходили, а вода всё прибывает.",
                    "voice": "assets/voice/vex_5.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Он крутит маховик на четверть оборота — тот идёт свободно, как в пустоте.",
                    "action": true,
                    "sfx": "sfx_gear",
                    "voice": "assets/voice/narr_vex_2.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "А вот и сам мастер. Я тебя записал вниз в восемнадцать сорок, Эрдан. Обратно так и не записал. Сейчас запишу.",
                    "voice": "assets/voice/vex_23.mp3",
                    "emotion": "thoughtful"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "unlock_codex",
                    "entry": "codex_pumps"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "in_party",
              "npc": "npc_resh"
            }
          ]
        },
        {
          "text": "Кто проходил через шлюз в ночь тринадцатого?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "vex_asked13"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "check": {
            "skill": "persuade",
            "difficulty": 45,
            "success": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Взвод Келла Ястреба. Двенадцать человек, все с клеймом стражи. Шли вниз, а запись делали наверх — так быстрее, сказал старшина.",
                        "voice": "assets/voice/vex_4.mp3"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "npc_vex",
                        "delta": 8
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            },
            "fail": {
              "sections": [
                {
                  "steps": [
                    {
                      "kind": "line",
                      "line": {
                        "text": "Записи я веду, а не пересказываю. Приди с бумагой от инспектора — покажу журнал целиком.",
                        "voice": "assets/voice/vex_9.mp3"
                      }
                    },
                    {
                      "kind": "effect",
                      "effect": {
                        "type": "change_disposition",
                        "target": "npc_vex",
                        "delta": -4
                      }
                    }
                  ]
                }
              ],
              "goto": "stay"
            }
          },
          "once": true,
          "conds": [
            {
              "type": "flag",
              "flag": "vex_asked13",
              "not": true
            }
          ]
        },
        {
          "text": "Как спуститься к помпе?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Через шлюз, час ходу. Дальше сам машинный зал, в нём — помпа.",
                    "voice": "assets/voice/vex_8.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Ниже машинного зала не ходи: там вода стоит и, говорят, ходит.",
                    "voice": "assets/voice/vex_6.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Ты спускался ниже седьмого? Нет? Тогда не спорь со мной про воду.",
                    "voice": "assets/voice/vex_11.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "На восьмом теперь считают не часы, а уголь: сколько унёс, столько и прожил.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/vex_12.mp3"
                  }
                }
              ]
            }
          ],
          "goto": "stay"
        },
        {
          "text": "Вот выписка из архива. Покажи журнал целиком.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Векс читает выписку, сверяет номер с корешком журнала и только потом разворачивает книгу к тебе.",
                    "action": true,
                    "sfx": "snd_page",
                    "voice": "assets/voice/narr_vex_3.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Двенадцать — вниз в двадцать ноль-ноль. Обратно — одиннадцать, в шесть утра. Одного я так и не записал: решил, что ошибся в счёте.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/vex_13.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Теперь вижу, что не ошибся. Журнал врёт редко.",
                    "emotion": "sad",
                    "voice": "assets/voice/vex_14.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "vex_journal"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_vex",
                    "delta": 6
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_vex_journal"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "has_item",
              "item": "item_roster"
            },
            {
              "type": "flag",
              "flag": "vex_journal",
              "not": true
            }
          ]
        },
        {
          "text": "Есть работа для дознавателя?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Есть. В галерее восьмого, на трубном узле, стоит мерная рейка. Запиши, где сейчас вода. Надзор шлёт сводки «уровень стабилен», а я своим глазам верю больше, чем их чернилам. Двенадцать марок за цифру.",
                    "voice": "assets/voice/vex_15.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "vex_job"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "vex_job",
              "not": true
            },
            {
              "type": "flag",
              "flag": "coal_stolen",
              "not": true
            }
          ]
        },
        {
          "text": "Вот замер с рейки.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Два и три четверти аршина. А тринадцатого стоял один — вон, мелом отмечено.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/vex_16.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "А в сводке Надзора — «стабилен». Значит, сводку пишут не по рейке, а под диктовку. И диктует тот, кому нужно, чтобы восьмой залило тихо.",
                    "emotion": "angry",
                    "voice": "assets/voice/vex_17.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "vex_job_done"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_vex",
                    "delta": 4
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_vex_job_done"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "vex_job"
            },
            {
              "type": "has_item",
              "item": "item_gauge_note"
            },
            {
              "type": "flag",
              "flag": "vex_job_done",
              "not": true
            }
          ]
        },
        {
          "text": "Келл сказал: «спроси у Векса, он записывал».",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "vex_kell_word"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "vex_asked13"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Векс хмыкает и, не глядя, кладёт ладонь на корешок журнала.",
                    "action": true,
                    "sfx": "snd_page",
                    "voice": "assets/voice/narr_vex_4.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Келл меня назвал? Тогда скажу, раз старшина разрешил. Двенадцать вниз, с клеймом стражи, в двадцать ноль-ноль.",
                    "emotion": "calm",
                    "voice": "assets/voice/vex_18.mp3"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "А сколько вернулось, я вслух не считаю. Принеси наряд из архива, и посчитаем вместе.",
                    "emotion": "thoughtful",
                    "voice": "assets/voice/vex_19.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_vex",
                    "delta": 4
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "kell_pressed"
            },
            {
              "type": "flag",
              "flag": "vex_kell_word",
              "not": true
            }
          ]
        },
        {
          "text": "Мне вниз. Передать что-нибудь?",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Передай. Носильщики после воды вниз не ходят, а в Сухом ряду топить нечем.",
                    "voice": "assets/voice/vex_21.mp3",
                    "emotion": "thoughtful"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "У ящика стоит мешок с биркой «Сухой ряд», шесть кило. Отдашь старьёвщику — заплатит пятнадцать марок. И не отсыпай: он взвесит.",
                    "voice": "assets/voice/vex_22.mp3",
                    "emotion": "calm"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "coal_job_offered"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "conds": [
            {
              "type": "flag",
              "flag": "coal_job_offered",
              "not": true
            },
            {
              "type": "flag",
              "flag": "coal_job_taken",
              "not": true
            }
          ]
        },
        {
          "text": "Покажи, что есть в продаже.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "line",
                  "line": {
                    "text": "Торг без разговоров. Люблю такие.",
                    "emotion": "calm",
                    "voice": "assets/voice/vex_7.mp3"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "open_trade",
                    "npc": "npc_vex"
                  }
                }
              ]
            }
          ],
          "goto": "end"
        },
        {
          "text": "Строка о возвращении написана не твоей рукой.",
          "conds": [
            {
              "type": "flag",
              "flag": "vex_journal"
            },
            {
              "type": "flag",
              "flag": "vex_return_hand",
              "not": true
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "vex_return_hand"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Не моя. В шесть утра журнал был у старшины: он сам вписал взвод обратно, конторскими чернилами, а мне велел поставить время. Я поставил. Время — единственное, что там правда.",
                    "voice": "assets/voice/vex_26.mp3",
                    "emotion": "thoughtful"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "fire_rule",
                    "rule": "rule_vex_return_hand"
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Режим тишины сняли.",
          "conds": [
            {
              "type": "flag",
              "flag": "kast_hand"
            },
            {
              "type": "flag",
              "flag": "vex_lifted",
              "not": true
            }
          ],
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "set_flag",
                    "flag": "vex_lifted"
                  }
                },
                {
                  "kind": "line",
                  "line": {
                    "text": "Сняли. Вводят шёпотом и снимают шёпотом, а журнал всё помнит. Проходи, дознаватель: сегодня тебя записываю я, а не Келл.",
                    "voice": "assets/voice/vex_20.mp3",
                    "emotion": "calm"
                  }
                },
                {
                  "kind": "effect",
                  "effect": {
                    "type": "change_disposition",
                    "target": "npc_vex",
                    "delta": 3
                  }
                }
              ]
            }
          ],
          "goto": "stay",
          "once": true
        },
        {
          "text": "Показать Вексу находку у затвора.",
          "sections": [
            {
              "steps": [
                {
                  "kind": "effect",
                  "effect": {
                    "type": "present_item",
                    "ok": "Жетон",
                    "fail": "Не_то",
                    "required": "item_guard_token"
                  }
                }
              ]
            }
          ],
          "goto": "Жетон",
          "conds": [
            {
              "type": "flag",
              "flag": "clue_guard"
            },
            {
              "type": "flag",
              "flag": "vex_token",
              "not": true
            }
          ]
        },
        {
          "text": "Мне пора.",
          "sections": [],
          "goto": "end"
        }
      ]
    },
    {
      "id": "Жетон",
      "label": "Жетон с тела у затвора",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Векс ведёт пальцем по журналу, пока не находит номер.",
                "voice": "assets/voice/narr_vex_5.mp3",
                "action": true,
                "sfx": "snd_page"
              }
            },
            {
              "kind": "line",
              "line": {
                "text": "Медь взвода Ястреба. По журналу этот номер ушёл вниз тринадцатого, а обратно никто не расписался.",
                "voice": "assets/voice/vex_24.mp3",
                "emotion": "thoughtful"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "set_flag",
                "flag": "vex_token"
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "change_disposition",
                "target": "npc_vex",
                "delta": 3
              }
            },
            {
              "kind": "effect",
              "effect": {
                "type": "fire_rule",
                "rule": "rule_vex_token"
              }
            }
          ]
        }
      ],
      "goto": "Начало",
      "choices": []
    },
    {
      "id": "Не_то",
      "label": "Не та вещь",
      "sections": [
        {
          "steps": [
            {
              "kind": "line",
              "line": {
                "text": "Мне это ни к чему. Я пишу, кто прошёл, а не что у них в карманах.",
                "voice": "assets/voice/vex_25.mp3",
                "emotion": "calm"
              }
            }
          ]
        }
      ],
      "goto": "Начало",
      "choices": []
    }
  ]
}
